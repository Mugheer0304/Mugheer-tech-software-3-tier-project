# ============================================================================
# MUGHEER — Environment configuration template
# Copy to .env and fill values. NEVER commit real secrets.
# Production secrets live in AWS Secrets Manager (see terraform/modules/iam).
# ============================================================================

# --- Core runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
INTERNAL_SERVICE_TOKEN=change-me-internal-token-min-32-chars

# --- PostgreSQL ---
DATABASE_URL=postgresql://mugheer:mugheer@localhost:5432/mugheer?schema=public

# --- Redis (cache + BullMQ queues) ---
REDIS_URL=redis://localhost:6379

# --- JWT / sessions ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# --- Stripe (primary payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONITORING_MONTHLY=
STRIPE_PRICE_AUTOMATION_MONTHLY=
STRIPE_PRICE_RETAINER_MONTHLY=

# --- PayPal (secondary payments) ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Object storage (S3) ---
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET_ASSETS=mugheer-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- SMTP / email notifications ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Mugheer <no-reply@mugheer.com>

# --- AI services (provider-agnostic: any OpenAI-compatible endpoint) ---
AI_GATEWAY_URL=http://localhost:8100
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_USD=500
AI_ANOMALY_URL=http://localhost:8101
AI_TRIAGE_URL=http://localhost:8102
AI_SCOPING_URL=http://localhost:8103
AI_CODEASSIST_URL=http://localhost:8104

# --- Monitoring ---
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001

# --- Frontend ---
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=ws://localhost:3000
