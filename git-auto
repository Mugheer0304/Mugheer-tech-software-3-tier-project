  if [ "$CURRENT_REMOTE" != "$REMOTE_URL" ]; then
    warn "origin already points to $CURRENT_REMOTE — leaving it as-is."
    warn "If you meant to target the Mugheer repo, run: git remote set-url origin $REMOTE_URL"
  fi
fi

