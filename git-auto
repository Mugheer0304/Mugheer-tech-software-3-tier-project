if [ "$DO_PUSH" -eq 1 ]; then
  if [ "$FORCE_PUSH" -eq 1 ]; then
    log "Force-pushing to origin/$BRANCH (--force-push was set — this OVERWRITES remote history)"
    if git push -u origin "$BRANCH" --force; then
      log "Force-push succeeded. Repo is live at:"
      echo "  https://github.com/Mugheer0304/Mugheer-tech-software-3-tier-project"
    else
      err "Force-push failed. Check your GitHub authentication (SSH key / PAT / gh auth login)."
      exit 1
    fi
  else
    log "Pushing to origin/$BRANCH"
    PUSH_LOG="$(mktemp)"
    if git push -u origin "$BRANCH" 2>"$PUSH_LOG"; then
      log "Push succeeded. Repo is live at:"
      echo "  https://github.com/Mugheer0304/Mugheer-tech-software-3-tier-project"
      rm -f "$PUSH_LOG"
    else
      if grep -qi "rejected\|fetch first\|non-fast-forward" "$PUSH_LOG"; then
        err "Push rejected: the remote branch has commits your local repo doesn't have."
        err "This usually happens when the GitHub repo was created with an auto-generated"
        err "README/LICENSE/.gitignore. You have two options:"
        echo
        echo "  1) If the remote only has GitHub's auto-generated starter files (safe to replace):"
        echo "       git push -u origin $BRANCH --force"
        echo "     or simply re-run this script with: --force-push"
        echo
        echo "  2) If the remote has content you want to KEEP, merge instead:"
        echo "       git pull --allow-unrelated-histories origin $BRANCH"
        echo "       # resolve any conflicts, then:"
        echo "       git add <resolved files>"
        echo "       git commit -m "merge: reconcile with existing remote history""
        echo "       git push -u origin $BRANCH"
        echo
        echo "  Check what's on the remote first with:"
        echo "       git fetch origin && git log origin/$BRANCH --oneline --stat"
      else
        err "Push failed — likely an authentication issue."
        err "Set up SSH keys or a GitHub Personal Access Token (see the header of"
        err "this script for instructions), then re-run: git push -u origin $BRANCH"
      fi
      cat "$PUSH_LOG" >&2
      rm -f "$PUSH_LOG"
      exit 1
    fi
  fi
else
  warn "Skipped push (--no-push was set). To push later, run:"
  warn "  cd $(pwd) && git push -u origin $BRANCH"
fi

