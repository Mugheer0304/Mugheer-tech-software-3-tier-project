###############################################################################
# Mugheer — Full Repository Bootstrap Script
#
# Recreates the ENTIRE Mugheer three-tier project scaffold (docs, frontend,
# backend-core, ai-services, worker, k8s, terraform, monitoring, CI/CD,
# scripts) from scratch, commits it in 12 logical,
# conventional-commit-style stages, and pushes it to:
#
#   https://github.com/Mugheer0304/Mugheer-tech-software-3-tier-project.git
#
# Target: AWS EC2, Ubuntu.
#
# Usage:
#   chmod +x setup-mugheer-repo.sh
#   ./setup-mugheer-repo.sh                       # clone-or-create + push to main
#   ./setup-mugheer-repo.sh --dir myfolder         # use a custom local folder name
#   ./setup-mugheer-repo.sh --no-push              # build + commit locally only
#   ./setup-mugheer-repo.sh --branch develop       # push to a different branch
#   ./setup-mugheer-repo.sh --force-push           # overwrite remote history (use with care)
#
# Authentication: this script does NOT embed any credentials. Before running
# it, make sure this machine can already push to the repo above — either:
#   (a) SSH:  ssh-keygen -t ed25519 -C "you@example.com"  then add the public
#       key under GitHub → Settings → SSH and GPG keys, and use an SSH remote
#       (git@github.com:Mugheer0304/Mugheer-tech-software-3-tier-project.git), or
#   (b) HTTPS + PAT: `git config --global credential.helper store` and enter
#       a GitHub Personal Access Token the first time you're prompted, or
#   (c) `gh auth login` if you have the GitHub CLI installed.
#
# If push is REJECTED (not an auth error) with "fetch first" / "non-fast-forward":
# your GitHub repo already has commits (commonly from GitHub's own README/LICENSE
# auto-init on repo creation). The script will detect this and print the exact
# fix — either --force-push (overwrite remote) or a merge (keep both histories).
###############################################################################

set -euo pipefail

# ---------- defaults / flags -------------------------------------------------

TARGET_DIR="Mugheer-tech-software-3-tier-project"
REMOTE_URL="https://github.com/Mugheer0304/Mugheer-tech-software-3-tier-project.git"
BRANCH="main"
DO_PUSH=1
FORCE_PUSH=0

while [ $# -gt 0 ]; do
  case "$1" in
    --dir) TARGET_DIR="$2"; shift 2 ;;
    --branch) BRANCH="$2"; shift 2 ;;
    --no-push) DO_PUSH=0; shift ;;
    --force-push) FORCE_PUSH=1; shift ;;
    -h|--help)
      echo "Usage: $0 [--dir <folder>] [--branch <name>] [--no-push] [--force-push]"
      exit 0
      ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

# ---------- helpers -----------------------------------------------------------

log()  { echo -e "\n\033[1;32m==> $*\033[0m"; }
warn() { echo -e "\033[1;33m[warn] $*\033[0m"; }
err()  { echo -e "\033[1;31m[error] $*\033[0m" >&2; }

SUDO="sudo"
if [ "$(id -u)" -eq 0 ]; then SUDO=""; fi

# ---------- pre-flight: git installed? ---------------------------------------

if ! command -v git >/dev/null 2>&1; then
  log "git not found — installing it"
  $SUDO apt-get update -y
  $SUDO apt-get install -y git
fi

if ! command -v git >/dev/null 2>&1; then
  err "git installation failed. Aborting."
  exit 1
fi

log "git version: $(git --version)"

# ---------- prepare the working directory ------------------------------------

if [ -d "$TARGET_DIR/.git" ]; then
  warn "'$TARGET_DIR' already contains a git repo — reusing it (existing history is kept)."
  cd "$TARGET_DIR"
else
  log "Creating project directory: $TARGET_DIR"
  mkdir -p "$TARGET_DIR"
  cd "$TARGET_DIR"
  git init -b "$BRANCH" -q
fi

git config user.email "$(git config user.email 2>/dev/null || echo "devteam@mugheer.com")"
git config user.name  "$(git config user.name  2>/dev/null || echo "Mugheer Dev Team")"

log "Writing project files to $(pwd)"

